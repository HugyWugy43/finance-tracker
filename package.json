{
  "name": "orbit-finance",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --import ./scripts/runtime-env.mjs ./node_modules/vinext/dist/cli.js dev --port 5173",
    "build": "node --import ./scripts/runtime-env.mjs ./node_modules/vinext/dist/cli.js build",
    "start": "node --import ./scripts/runtime-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --port 4173 --inspector-port 0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib db tests scripts vite.config.ts",
    "test": "node tests/verify.mjs && node tests/adversarial.mjs && node tests/usability.mjs && node tests/chart-readability.mjs && node tests/visual.mjs && node tests/project-health.mjs",
    "test:adversarial": "node tests/adversarial.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import ./scripts/runtime-env.mjs ./node_modules/wrangler/bin/wrangler.js d1 migrations apply DB --local --persist-to .wrangler/state",
    "format": "prettier --write app components lib db tests scripts *.ts *.mjs *.json *.jsonc *.md docs",
    "format:check": "prettier --check app components lib db tests scripts *.ts *.mjs *.json *.jsonc *.md docs",
    "test:usability": "node tests/usability.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "playwright": "^1.62.1",
    "prettier": "^3.9.10",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
